# Скопируйте в .env и заполните: cp .env.example .env
# Файл .env в git не попадает (см. .gitignore) — реальные секреты только здесь.

# ============================================================================
# Обязательное
# ============================================================================

# Токен бота MAX. Получить у @masterbot в мессенджере MAX.
MAX_BOT_TOKEN=your_token_here

# ============================================================================
# Платформа MAX
# ============================================================================

# Базовый URL API. Менять только если платформа сменила домен.
# MAX_API_BASE_URL=https://platform-api2.max.ru

# Путь к PEM-файлу с дополнительным корневым сертификатом (например, УЦ
# Минцифры РФ), если системного хранилища не хватает.
# Альтернатива для Docker — положить .crt в certs/ (см. certs/README.md).
# MAX_CA_BUNDLE=/app/certs/russian-trusted-root-ca.pem

# Общий лимит исходящих запросов к API, запросов в секунду.
# Реальный лимит платформы ~30 — держим запас.
# MAX_API_RPS=25

# Отдельный лимит на отправку и удаление сообщений. Это не то же самое, что
# лимит выше: за частую отправку платформа блокирует бота как спамера,
# а не отвечает ошибкой 429.
# MAX_API_MESSAGE_RPS=2

# ============================================================================
# Режим работы
# ============================================================================

# polling — локальная разработка, ничего не слушает и не требует публичного адреса.
# webhook — прод: платформа сама шлёт апдейты на ваш адрес.
BOT_MODE=polling

# --- Только при BOT_MODE=webhook -------------------------------------------

# Публичный https-адрес бота БЕЗ пути. Путь бот добавит сам и зарегистрирует
# подписку в MAX при старте. Адрес должен быть доступен из интернета.
# WEBHOOK_HOST=https://bot.example.ru

# Путь маршрута для приёма апдейтов.
# WEBHOOK_PATH=/webhook

# ОБЯЗАТЕЛЕН при webhook: без секрета эндпоинт принимает любой POST без
# проверки подлинности, поэтому бот откажется стартовать.
# Сгенерировать: openssl rand -hex 32
# WEBHOOK_SECRET=

# Порт webhook-сервера. Тот же порт подставляется в проброс портов
# docker-compose — синхронизировать вручную не нужно.
PORT=8081

# Сколько апдейтов может одновременно обрабатываться в фоне. Ответ платформе
# приходит сразу, обработка идёт отдельной задачей; сверх этого лимита новые
# апдейты отклоняются 503 (MAX повторит доставку), а не копятся в открытых
# соединениях. НЕ защищает от дублей: дедупликации по update_id в шаблоне нет.
# WEBHOOK_MAX_PENDING_UPDATES=500

# Сколько секунд ждать завершения принятых апдейтов при остановке бота.
# WEBHOOK_DRAIN_TIMEOUT=20

# Лимиты uvicorn на приём соединений: сверх них лишние соединения отбиваются
# сразу, а не копятся до исчерпания дескрипторов.
# WEBHOOK_LIMIT_CONCURRENCY=256
# WEBHOOK_BACKLOG=256
# WEBHOOK_KEEPALIVE_TIMEOUT=5

# ============================================================================
# Доступ и логирование
# ============================================================================

# false (по умолчанию) — maintenance-режим: бот отвечает только ADMIN_IDS.
# true — бот открыт для всех.
PROD=false

# Список user_id администраторов через запятую: 123456, 789012
# Свой user_id можно узнать у @userinfobot.
ADMIN_IDS=

# debug / info / warning / error
LOG_LEVEL=info

# ============================================================================
# База данных (опционально, ставится через `uv sync --extra db`)
# ============================================================================

# Драйвер обязательно асинхронный (+asyncpg) — с синхронным бот не стартует.
# Без этой переменной слой БД не инициализируется вовсе.
# DATABASE_URL=postgresql+asyncpg://bot:bot@db:5432/bot

# Креды Postgres для docker-compose (профиль db).
# POSTGRES_USER=bot
# POSTGRES_PASSWORD=bot
# POSTGRES_DB=bot

# ============================================================================
# Метрики (опционально, ставится через `uv sync --extra metrics`)
# ============================================================================

# METRICS_ENABLED=false
# METRICS_ADDR=:9090

# ============================================================================
# Заполняется автоматически при деплое — вручную задавать не нужно
# ============================================================================

# BUILD_TAG — тег развёрнутого образа, показывается командой /v.
# Подставляется из IMAGE_TAG (см. docker/docker-compose.prod.yml).
